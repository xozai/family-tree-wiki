# ── Production environment template ───────────────────────────────────────────
# Copy to .env.production and fill in real values before deploying:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL is overridden in docker-compose.prod.yml to use the postgres
# service name, so the value here is only a fallback for local tooling.
DATABASE_URL="postgresql://familytree:CHANGE_ME_DB_PASSWORD@postgres:5432/familytree"

POSTGRES_USER=familytree
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=familytree

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_2

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
UPLOADS_DIR=/app/uploads
# Set to the public URL of your site (used for CORS)
CORS_ORIGIN=http://your-domain.com

# ── Frontend ───────────────────────────────────────────────────────────────────
# In production the frontend calls /api via the nginx reverse proxy.
# Leave as /api unless you are serving on a subpath.
VITE_API_URL=/api

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_PORT=80
