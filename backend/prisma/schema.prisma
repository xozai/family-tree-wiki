generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum UserProfileLinkStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PrivacyLevel {
  PUBLIC
  PRIVATE
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  email                String    @unique
  passwordHash         String
  fullName             String
  relationshipToFamily String
  role                 Role      @default(VIEWER)
  status               UserStatus @default(PENDING)
  approvedById         String?
  approvedBy           User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedUsers        User[]    @relation("ApprovedBy")
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  createdMembers       FamilyMember[] @relation("CreatedBy")
  editedMembers        FamilyMember[] @relation("LastEditedBy")
  revisions            ProfileRevision[]
  uploadedMedia        Media[]
  createdInvites       InviteToken[]  @relation("CreatedInvites")
  usedInvite           InviteToken?   @relation("UsedInvite")
  auditLogs            AuditLog[]
  profileLinks         UserProfileLink[]
}

model UserProfileLink {
  id             String                @id @default(uuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMemberId String
  familyMember   FamilyMember          @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  status         UserProfileLinkStatus @default(PENDING)
  relationshipLabel String?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([userId, familyMemberId])
  @@index([userId, status])
  @@index([familyMemberId, status])
}

model InviteToken {
  id          String    @id @default(uuid())
  token       String    @unique
  note        String?
  createdById String
  createdBy   User      @relation("CreatedInvites", fields: [createdById], references: [id])
  usedById    String?   @unique
  usedBy      User?     @relation("UsedInvite", fields: [usedById], references: [id])
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model FamilyMember {
  id            String       @id @default(uuid())
  firstName     String
  lastName      String
  maidenName    String?
  alternateNames String[]    @default([])
  birthDate     DateTime?
  birthPlace    String?
  deathDate     DateTime?
  deathPlace    String?
  biography     String?      // Rich text HTML
  occupation    String?
  education     String?
  achievements  String?
  privacyLevel  PrivacyLevel @default(PUBLIC)
  isLiving       Boolean      @default(false)
  isMinor        Boolean      @default(false)

  createdById   String?
  createdBy     User?        @relation("CreatedBy", fields: [createdById], references: [id])
  lastEditedById String?
  lastEditedBy  User?        @relation("LastEditedBy", fields: [lastEditedById], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  relationshipsAsA  Relationship[] @relation("PersonA")
  relationshipsAsB  Relationship[] @relation("PersonB")
  revisions         ProfileRevision[]
  media             Media[]
  tags              TagsOnMembers[]
  userProfileLinks  UserProfileLink[]
}

model Relationship {
  id               String           @id @default(uuid())
  personAId        String
  personA          FamilyMember     @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personBId        String
  personB          FamilyMember     @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)
  relationshipType RelationshipType
  confidence       Int              @default(100) // 0-100
  createdAt        DateTime         @default(now())

  @@unique([personAId, personBId, relationshipType])
}

model ProfileRevision {
  id             String       @id @default(uuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  contentSnapshot Json
  editSummary    String?
  editedById     String?
  editedBy       User?        @relation(fields: [editedById], references: [id])
  createdAt      DateTime     @default(now())
}

model Media {
  id             String       @id @default(uuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  fileUrl        String
  thumbUrl       String?
  fileName       String
  mimeType       String
  fileSize       Int
  caption        String?
  isPrimary      Boolean      @default(false)
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())
}

model Tag {
  id      String          @id @default(uuid())
  name    String          @unique
  members TagsOnMembers[]
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  targetName String?
  meta       Json?
  createdAt  DateTime @default(now())
}

model TagsOnMembers {
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memberId, tagId])
}
