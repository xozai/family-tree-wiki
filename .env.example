# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# In Docker Compose the host should be the service name (e.g. "postgres").
DATABASE_URL="postgresql://familytree:familytree_secret@localhost:5432/familytree"

POSTGRES_USER=familytree
POSTGRES_PASSWORD=familytree_secret
POSTGRES_DB=familytree

# ── Auth ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here_change_me_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me_min_32_chars

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
UPLOADS_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

# ── Frontend ───────────────────────────────────────────────────────────────────
# Used at build time by Vite. In production the frontend calls /api directly
# through the nginx reverse proxy, so this should be left as /api.
VITE_API_URL=http://localhost:3001/api

# ── Nginx (production only) ───────────────────────────────────────────────────
NGINX_PORT=80
