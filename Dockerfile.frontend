# ── Stage 1: Build ────────────────────────────────────────────────────────────
# Compiles the React/Vite app into static files.
FROM node:20-alpine AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# In production nginx proxies /api, so VITE_API_URL defaults to /api fallback
# in the source code. Override here if needed via --build-arg VITE_API_URL=...
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Stage 2: Production ───────────────────────────────────────────────────────
# Serve compiled static files with nginx.
FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

# SPA nginx config: routes all paths to index.html
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
